# Copy to .env and fill in. Only required for live Gemini generation.
# Without a key, the generator runs in STUB mode (no network, no cost).

# Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Generation mode: live (real calls), stub (deterministic canned, no key),
# replay (use cassettes/ for offline tests). Defaults to stub when no key.
GEMINI_MODE=stub

# Word-bank quality floor (Broda score). Entries scored below this are dropped
# before filling, so junk fill never reaches the clue provider. Default 51.
# Set to 0 to keep the entire word list.
GEMINI_MIN_SCORE=51

# Where generated puzzles are stored: local (disk) or gcs (Cloud Storage).
# Local dev uses disk; production sets gcs.
PUZZLE_STORE=local

# GCS bucket name (only used when PUZZLE_STORE=gcs).
PUZZLE_BUCKET=

# Local on-disk puzzle root (only used when PUZZLE_STORE=local).
LOCAL_DATA_DIR=./local-data

# Application environment. "dev" enables the /api/dev/generate endpoint.
APP_ENV=dev
